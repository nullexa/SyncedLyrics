{
  "manifest_version": 3,
  "name": "SongSync",
  "version": "0.1",
  "description": "Extract Word-by-word synced lyrics from music.youtube.com using Better Lyrics (https://better-lyrics.boidu.dev/) extention",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://music.youtube.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "SongSync preview",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
